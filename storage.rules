rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ── Foto Kenangan Ruangan (/rooms/{roomId}/memories/{memoryId}/{fileName}) ──
    match /rooms/{roomId}/memories/{memoryId}/{fileName} {
      // Membaca foto: wajib terautentikasi (Anonymous/User)
      allow read: if request.auth != null;
      
      // Mengunggah foto kenangan:
      // 1. Wajib terautentikasi
      // 2. Ukuran file maksimal 5MB (kompresi WebP klien normalnya < 500KB)
      // 3. Tipe konten строго dibatasi hanya gambar resmi: webp, jpeg, atau png
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
        
      // Menghapus foto: diizinkan bagi pengguna terautentikasi
      allow delete: if request.auth != null;
    }

    // ── File Musik / Audio Ruangan (/rooms/{roomId}/music/{fileName}) ──
    match /rooms/{roomId}/music/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null;
    }
  }
}
