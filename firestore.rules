rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Room and all its subcollections (memories, stories, plans, quotes, little_things, calendar, invite_tokens, members)
    match /rooms/{roomId} {
      allow read, write: if true;

      match /{subcollection}/{document=**} {
        allow read, write: if true;
      }
    }
  }
}
